{
  "name": "claude-artifacts-viewer",
  "private": true,
  "version": "1.0.0",
  "description": "Espejo público de tus artefactos de Claude en tu propio dominio.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "add": "node scripts/cli.js add",
    "remove": "node scripts/cli.js remove",
    "list": "node scripts/cli.js list"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
